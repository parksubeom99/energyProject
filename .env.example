# GreenPulse — 환경 변수 설정
# ==============================
# 이 파일을 .env로 복사하여 사용:
#   cp .env.example .env

# --- Claude API (AI 최적화 코드 생성) ---
# Anthropic 콘솔에서 발급: https://console.anthropic.com
CLAUDE_API_KEY=sk-ant-your-key-here

# --- JWT 인증 (프로덕션 배포 시 반드시 변경) ---
JWT_SECRET=greenpulse-dev-secret-change-in-prod

# --- 데이터베이스 (Docker 기본값) ---
DATABASE_URL=postgresql://greenpulse:greenpulse@postgres:5432/greenpulse

# --- Redis (Docker 기본값) ---
REDIS_URL=redis://redis:6379/0

# --- Kafka (Docker 기본값) ---
KAFKA_BOOTSTRAP_SERVERS=kafka:9092

# --- 디버그 모드 ---
DEBUG=true
